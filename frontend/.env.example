# ============================================================
# BACKEND API URLS
# ============================================================

# Local backend URL (Docker Compose or direct Python run)
# Make sure your backend is running: cd backend && docker compose up --build
VITE_API_URL_DEV=http://localhost:8000

# Deployed backend URL (Google Cloud Run — no trailing slash)
# Find it at: https://console.cloud.google.com/run
VITE_API_URL_PROD=https://your-cloud-run-service-xxxxxxxxxx.run.app
