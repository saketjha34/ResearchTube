# Required API credentials
GEMINI_API_KEY=your_gemini_api_key
YOUTUBE_API_KEY=your_youtube_data_api_key

# provider for chat models and embeddings, with Gemini available as fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Runtime environment and database
ENVIRONMENT=dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/youtube_research
# Set this when ENVIRONMENT=prod
PROD_DATABASE_URL=

# LLM and embeddings
GEMINI_MODEL=gemini-3.5-flash
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# Generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_random_64_character_hex_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_ROTATION_GRACE_PERIOD_SEC=30

# Google OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
FRONTEND_URL_DEV=http://localhost:5173
# Required when ENVIRONMENT=prod
FRONTEND_URL_PROD=

# Email and password reset
EMAIL_PROVIDER=smtp
EMAIL_FROM=ResearchTubeAI <you@example.com>
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Optional external services
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v1
E2B_API_KEY=
PYTHON_SANDBOX_TIMEOUT_SEC=60
CPP_SANDBOX_TIMEOUT_SEC=60
CPP_DEFAULT_COMPILER_FLAGS=-std=c++20 -O2 -Wall -Wextra

# Optional YouTube transcript proxies, generally used in production
YOUTUBE_PROXY_URL=
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
