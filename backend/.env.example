# ============================================================
# API KEYS
# ============================================================

GEMINI_API_KEY=AIza...your_gemini_key_here

YOUTUBE_API_KEY=AIza...your_youtube_data_api_key_here

# Optional — not currently used
# OPENAI_API_KEY=sk-...


# ============================================================
# ENVIRONMENT
# ============================================================

# 'dev' = local Docker | 'prod' = Cloud Run + Supabase
ENVIRONMENT=dev


# ============================================================
# DATABASE
# ============================================================

# Local Docker PostgreSQL (used when ENVIRONMENT=dev)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/youtube_research

# Hosted PostgreSQL / Supabase (used when ENVIRONMENT=prod)
# Use Supabase Connection Pooler on port 6543 (transaction mode) for serverless environments (e.g. Vercel)
# PROD_DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-[region].pooler.supabase.com:6543/postgres


# ============================================================
# RAG / EMBEDDINGS
# ============================================================

EMBEDDING_MODEL=gemini-embedding-001


# ============================================================
# JWT AUTH
# ============================================================

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_random_64_char_secret_here

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30


# ============================================================
# GOOGLE OAUTH
# ============================================================

GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# Dev frontend (default)
FRONTEND_URL_DEV=http://localhost:5173

# Production frontend
# FRONTEND_URL_PROD=https://your-app.vercel.app


# ============================================================
# PROXY (Production only — bypasses YouTube GCP IP block)
# ============================================================

# Option A: ScraperAPI (recommended, 1000 free req/month)
# YOUTUBE_PROXY_URL=http://scraperapi:YOUR_API_KEY@proxy-server.scraperapi.com:8001

# Option B: Any generic proxy
# YOUTUBE_PROXY_URL=http://username:password@proxy.host:port

# Option C: Webshare rotating residential
# WEBSHARE_PROXY_USERNAME=your_webshare_username
# WEBSHARE_PROXY_PASSWORD=your_webshare_password